    <worksheet name='GMV &amp; Order Index Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Benton Sans SemiDemi' fontsize='16'>GMV vs Order Volume - Indexed Growth (Sep 2016 =100)</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders.csv' name='federated.0hbw1f60kzg26x1fz8bkq1ml6zhb' />
          </datasources>
          <datasource-dependencies datasource='federated.0hbw1f60kzg26x1fz8bkq1ml6zhb'>
            <column caption='Order Index (Base=100)' datatype='real' name='[Calculation_0605331901431808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_count]) / WINDOW_AVG(SUM([order_count]), FIRST(), FIRST()+5) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GMV Index (Base=100)' datatype='real' name='[Calculation_0605331906269185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivered_gmv]) / WINDOW_AVG(SUM([delivered_gmv]), FIRST(), FIRST()+5) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
